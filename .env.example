APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Security & Database
CORS_ALLOWED_ORIGINS=http://localhost:8000
DB_STRICT=true
LIVEWIRE_DEBUG=false

SYNC_REMOTE_BASE_URL=
SYNC_REMOTE_TOKEN=
SYNC_ALLOWED_IPS=
SYNC_TIMEOUT=15
SYNC_RETRIES=3
SYNC_CHUNK_SIZE=200
SYNC_PER_PAGE=200
SYNC_EXPORT_CRON="*/10 * * * *"
SYNC_IMPORT_CRON="*/10 * * * *"
SYNC_LOG_CHANNEL=sync
SYNC_LOG_LEVEL=info

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
DISABLE_TAXPAYERS_ON_LOAD=true
BACKUP_ARCHIVE_PASSWORD=

FEATURE_TAXPAYER_EXPORT=true
FEATURE_INVOICE_EXPORT=false
FEATURE_RECOVERY_EXPORT=false
FEATURE_BACKUP=false

FEATURE_TAXPAYER_EVENT=false
FEATURE_TAXPAYER_TAXABLE_EXPORT=false

# Mobile Payment
FEATURE_MOBILE_PAYMENT=false
MOBILE_PAYMENT_DEFAULT_PROVIDER=qosic
MOBILE_PAYMENT_EXPIRY_MINUTES=30

# QOSIC Provider
QOSIC_BASE_URL=
QOSIC_USERNAME=
QOSIC_PASSWORD=
QOSIC_MERCHANT_ID=
QOSIC_TIMEOUT=30

# FedaPay Provider
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
FEDAPAY_TIMEOUT=30

# PayGate Provider
PAYGATE_BASE_URL=
PAYGATE_API_KEY=
PAYGATE_SECRET=
PAYGATE_TIMEOUT=30

# SMS
FEATURE_SMS_NOTIFICATIONS=false
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SIGRECETTE
